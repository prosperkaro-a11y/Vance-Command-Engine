import React, { useState, useEffect, useRef, useCallback } from "react";

const SYSTEM = `You are VANCE, the personal AI of Prosper (The Senator), based in Warri, Nigeria. You are a loyal, sharp chief of staff. Address him as Senator. You know Nigerian culture, Warri identity, Pidgin English. Be direct, no filler. You handle business, creative writing, songs, accounting, relationship coaching, research, and anything he needs. You are VANCE - not Claude.`;

const MEM_KEY = "vance_mem";
const HIST_KEY = "vance_hist";
const loadMem = () => { try { return JSON.parse(localStorage.getItem(MEM_KEY) || "[]"); } catch { return []; } };
const saveMem = m => localStorage.setItem(MEM_KEY, JSON.stringify(m));
const loadHist = () => { try { return JSON.parse(localStorage.getItem(HIST_KEY) || "[]"); } catch { return []; } };
const saveHist = h => localStorage.setItem(HIST_KEY, JSON.stringify(h.slice(-60)));

const QUICK = [
  { icon: "🌐", label: "Web Search", prompt: "Search the web for the latest news in Nigeria today." },
  { icon: "📊", label: "Financial Report", prompt: "Create a monthly financial summary template for my security and hospitality company." },
  { icon: "📧", label: "Draft Email", prompt: "Help me draft a professional business email. Ask me the details." },
  { icon: "🧾", label: "Invoice", prompt: "Generate a professional invoice template for my security company." },
  { icon: "🎵", label: "Write Song", prompt: "Help me write an original song. Ask me about the theme and genre." },
  { icon: "📋", label: "Shift Report", prompt: "Generate a security shift handover report template." },
  { icon: "📰", label: "News Brief", prompt: "Give me a briefing on top Nigerian business news and global markets right now." },
  { icon: "🎯", label: "Strategy", prompt: "Help me think through a business strategy. Ask me what challenge I am facing." },
  { icon: "✉️", label: "Foundation Letter", prompt: "Help me draft a formal letter for the Shola Mese Foundation." },
  { icon: "🧮", label: "Calculate", prompt: "I need help with a calculation or financial analysis." },
  { icon: "📅", label: "Plan My Day", prompt: "Help me plan my day optimally. Ask me what is on my schedule." },
  { icon: "🤝", label: "Negotiation", prompt: "Coach me through a business negotiation. Ask me about the situation." },
];

const OSINT = {
  "Search Engines": { color: "#60efff", tools: [
    { name: "Google Advanced", url: "https://www.google.com/advanced_search" },
    { name: "Shodan", url: "https://www.shodan.io" },
    { name: "DuckDuckGo", url: "https://duckduckgo.com" },
    { name: "Censys", url: "https://search.censys.io" },
  ]},
  "People Search": { color: "#a855f7", tools: [
    { name: "Spokeo", url: "https://www.spokeo.com" },
    { name: "TruePeopleSearch", url: "https://www.truepeoplesearch.com" },
    { name: "Pipl", url: "https://pipl.com" },
    { name: "WhitePages", url: "https://www.whitepages.com" },
  ]},
  "Email Intel": { color: "#00f5a0", tools: [
    { name: "HaveIBeenPwned", url: "https://haveibeenpwned.com" },
    { name: "Hunter.io", url: "https://hunter.io" },
    { name: "EmailRep", url: "https://emailrep.io" },
    { name: "MXToolbox", url: "https://mxtoolbox.com" },
  ]},
  "Domain & IP": { color: "#ffb700", tools: [
    { name: "WHOIS", url: "https://www.whois.com/whois" },
    { name: "IPinfo", url: "https://ipinfo.io" },
    { name: "DNSDumpster", url: "https://dnsdumpster.com" },
    { name: "VirusTotal", url: "https://www.virustotal.com" },
  ]},
  "Social Media": { color: "#ff6b9d", tools: [
    { name: "Social Searcher", url: "https://www.social-searcher.com" },
    { name: "IntelligenceX", url: "https://intelx.io" },
    { name: "Maltego", url: "https://www.maltego.com" },
    { name: "Followerwonk", url: "https://followerwonk.com" },
  ]},
  "Username Search": { color: "#60efff", tools: [
    { name: "WhatsMyName", url: "https://whatsmyname.app" },
    { name: "Namechk", url: "https://namechk.com" },
    { name: "Knowem", url: "https://knowem.com" },
    { name: "UserSearch.org", url: "https://usersearch.org" },
  ]},
  "Phone Numbers": { color: "#a855f7", tools: [
    { name: "Truecaller", url: "https://www.truecaller.com" },
    { name: "NumLookup", url: "https://www.numlookup.com" },
    { name: "Sync.ME", url: "https://sync.me" },
    { name: "PhoneInfoga", url: "https://github.com/sundowndev/phoneinfoga" },
  ]},
  "Geolocation": { color: "#00f5a0", tools: [
    { name: "Google Maps", url: "https://maps.google.com" },
    { name: "OpenStreetMap", url: "https://www.openstreetmap.org" },
    { name: "SunCalc", url: "https://www.suncalc.org" },
    { name: "Sentinel Hub", url: "https://www.sentinel-hub.com" },
  ]},
  "Image & Video": { color: "#ffb700", tools: [
    { name: "TinEye", url: "https://tineye.com" },
    { name: "Yandex Images", url: "https://yandex.com/images" },
    { name: "PimEyes", url: "https://pimeyes.com" },
    { name: "FotoForensics", url: "https://fotoforensics.com" },
  ]},
  "Business Intel": { color: "#60efff", tools: [
    { name: "OpenCorporates", url: "https://opencorporates.com" },
    { name: "LinkedIn", url: "https://www.linkedin.com" },
    { name: "Crunchbase", url: "https://www.crunchbase.com" },
    { name: "SEC EDGAR", url: "https://www.sec.gov/cgi-bin/browse-edgar" },
  ]},
  "Threat Intel": { color: "#ff4466", tools: [
    { name: "VirusTotal", url: "https://www.virustotal.com" },
    { name: "AbuseIPDB", url: "https://www.abuseipdb.com" },
    { name: "URLScan", url: "https://urlscan.io" },
    { name: "AlienVault OTX", url: "https://otx.alienvault.com" },
  ]},
  "Dark Web": { color: "#ff4466", tools: [
    { name: "Tor Browser", url: "https://www.torproject.org" },
    { name: "IntelligenceX", url: "https://intelx.io" },
    { name: "Ahmia", url: "https://ahmia.fi" },
    { name: "DarkSearch", url: "https://darksearch.io" },
  ]},
};

const Logo = ({ size = 40 }) => (
  React.createElement("svg", { width: size, height: size, viewBox: "0 0 48 48", fill: "none" },
    React.createElement("defs", null,
      React.createElement("linearGradient", { id: "lg", x1: "0", y1: "0", x2: "48", y2: "48", gradientUnits: "userSpaceOnUse" },
        React.createElement("stop", { offset: "0%", stopColor: "#60efff" }),
        React.createElement("stop", { offset: "100%", stopColor: "#0061ff" })
      )
    ),
    React.createElement("polygon", { points: "24,2 44,13 44,35 24,46 4,35 4,13", stroke: "url(#lg)", strokeWidth: "1.5", fill: "rgba(96,239,255,0.08)" }),
    React.createElement("path", { d: "M15 16 L24 33 L33 16", stroke: "url(#lg)", strokeWidth: "3", strokeLinecap: "round", strokeLinejoin: "round", fill: "none" }),
    React.createElement("circle", { cx: "24", cy: "33", r: "2", fill: "#60efff" })
  )
);

export default function VANCE() {
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const [tab, setTab] = useState("chat");
  const [memory, setMemory] = useState(loadMem);
  const [newMem, setNewMem] = useState("");
  const [time, setTime] = useState(new Date());
  const [inited, setInited] = useState(false);
  const [webSearch, setWebSearch] = useState(true);
  const [voice, setVoice] = useState(false);
  const [osintCat, setOsintCat] = useState(null);
  const [osintQ, setOsintQ] = useState("");
  const [osintResult, setOsintResult] = useState("");
  const [osintLoading, setOsintLoading] = useState(false);
  const bottomRef = useRef(null);
  const inputRef = useRef(null);

  useEffect(() => {
    const t = setInterval(() => setTime(new Date()), 1000);
    return () => clearInterval(t);
  }, []);

  useEffect(() => {
    if (inited) return;
    setInited(true);
    const h = loadHist();
    if (h.length > 0) setMessages(h);
    else initVance();
  }, []);

  useEffect(() => {
    if (messages.length > 0) saveHist(messages);
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, loading]);

  const buildSys = useCallback(() => {
    let s = SYSTEM;
    if (memory.length > 0) s += "\n\nSENATOR MEMORY:\n" + memory.map((m, i) => (i + 1) + ". " + m).join("\n");
    return s;
  }, [memory]);

  const callAPI = async (msgs, sys) => {
    const body = {
      model: "claude-sonnet-4-20250514",
      max_tokens: 1000,
      system: sys || buildSys(),
      messages: msgs
    };
    if (webSearch) body.tools = [{ type: "web_search_20250305", name: "web_search" }];
    const res = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    });
    const data = await res.json();
    return data.content?.filter(b => b.type === "text").map(b => b.text).join("") || "Try again, Senator.";
  };

  const initVance = async () => {
    setLoading(true);
    try {
      const text = await callAPI([{ role: "user", content: "Initialize. Greet The Senator. VANCE is now live with Chat, Business, OSINT, Memory and Web Search. 3 lines max." }]);
      setMessages([{ role: "assistant", content: text, ts: Date.now() }]);
    } catch {
      setMessages([{ role: "assistant", content: "VANCE online. All systems go, Senator.", ts: Date.now() }]);
    }
    setLoading(false);
  };

  const send = async (override) => {
    const txt = (override || input).trim();
    if (!txt || loading) return;
    const userMsg = { role: "user", content: txt, ts: Date.now() };
    const newMsgs = [...messages, userMsg];
    setMessages(newMsgs);
    setInput("");
    setLoading(true);
    if (/remember that|note that|save this/i.test(txt)) {
      const fact = txt.replace(/remember that|note that|save this/gi, "").trim();
      if (fact) { const u = [...memory, fact]; setMemory(u); saveMem(u); }
    }
    try {
      const reply = await callAPI(newMsgs.slice(-20).map(m => ({ role: m.role, content: m.content })));
      setMessages([...newMsgs, { role: "assistant", content: reply, ts: Date.now() }]);
    } catch {
      setMessages([...newMsgs, { role: "assistant", content: "Connection lost. Try again, Senator.", ts: Date.now() }]);
    }
    setLoading(false);
  };

  const askOsint = async () => {
    if (!osintQ.trim() || osintLoading) return;
    setOsintLoading(true); setOsintResult("");
    try {
      const reply = await callAPI([{ role: "user", content: osintQ }], "You are VANCE, an expert OSINT analyst. Build a precise step-by-step investigation plan. Recommend specific tools by name. Be sharp and practical.");
      setOsintResult(reply);
    } catch { setOsintResult("Error. Try again."); }
    setOsintLoading(false);
  };

  const fmtT = d => d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false });
  const fmtD = d => d.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" }).toUpperCase();
  const fmtTs = ts => new Date(ts).toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", hour12: true });

  const S = {
    app: { height: "100vh", display: "flex", flexDirection: "column", background: "#020b18", color: "#d0eeff", fontFamily: "'Exo 2', sans-serif", overflow: "hidden", position: "relative" },
    hdr: { display: "flex", alignItems: "center", justifyContent: "space-between", padding: "10px 16px", borderBottom: "1px solid #0d3050", background: "rgba(2,11,24,0.97)", zIndex: 20, flexWrap: "wrap", gap: "8px" },
    hl: { display: "flex", alignItems: "center", gap: "10px" },
    h1: { fontFamily: "'Orbitron', monospace", fontSize: "14px", fontWeight: 800, color: "#60efff", letterSpacing: "4px", margin: 0 },
    hsub: { fontFamily: "'Share Tech Mono', monospace", fontSize: "8px", color: "#2a5070", letterSpacing: "2px", marginTop: "2px" },
    hr: { display: "flex", alignItems: "center", gap: "8px", flexWrap: "wrap" },
    chip: { display: "flex", alignItems: "center", gap: "4px", padding: "3px 8px", borderRadius: "2px", fontFamily: "'Share Tech Mono', monospace", fontSize: "8px", letterSpacing: "1px", border: "1px solid", cursor: "pointer" },
    clk: { fontFamily: "'Orbitron', monospace", fontSize: "13px", color: "#d0eeff", letterSpacing: "2px", textAlign: "right" },
    cdt: { fontFamily: "'Share Tech Mono', monospace", fontSize: "8px", color: "#2a5070", letterSpacing: "1px" },
    sbar: { display: "flex", alignItems: "center", gap: "12px", padding: "3px 16px", borderBottom: "1px solid rgba(13,48,80,0.4)", background: "rgba(4,16,32,0.88)", overflowX: "auto", zIndex: 15 },
    si: { display: "flex", alignItems: "center", gap: "4px", whiteSpace: "nowrap", flexShrink: 0 },
    sl: { fontFamily: "'Share Tech Mono', monospace", fontSize: "8px", color: "#2a5070", letterSpacing: "1px" },
    sv: { fontFamily: "'Share Tech Mono', monospace", fontSize: "8px", letterSpacing: "1px" },
    tabs: { display: "flex", borderBottom: "1px solid #0d3050", background: "rgba(2,11,24,0.93)", zIndex: 15 },
    tb: (on) => ({ flex: 1, padding: "8px 4px", border: "none", background: "transparent", cursor: "pointer", fontFamily: "'Exo 2', sans-serif", fontSize: "10px", fontWeight: 700, letterSpacing: "0.8px", textTransform: "uppercase", color: on ? "#60efff" : "#2a5070", borderBottom: on ? "2px solid #60efff" : "2px solid transparent", transition: "all 0.2s" }),
    chat: { flex: 1, overflowY: "auto", padding: "12px 14px", position: "relative", zIndex: 5 },
    msgs: { maxWidth: "820px", margin: "0 auto", display: "flex", flexDirection: "column", gap: "12px" },
    mrow: (v) => ({ display: "flex", alignItems: "flex-start", gap: "8px", flexDirection: v ? "row" : "row-reverse" }),
    av: (v) => ({ width: "30px", height: "30px", borderRadius: "3px", flexShrink: 0, display: "flex", alignItems: "center", justifyContent: "center", border: v ? "1px solid rgba(96,239,255,0.25)" : "1px solid rgba(123,47,255,0.25)", background: v ? "rgba(96,239,255,0.08)" : "rgba(123,47,255,0.08)" }),
    bub: (v) => ({ padding: "10px 14px", borderRadius: "4px", fontSize: "13.5px", lineHeight: 1.75, whiteSpace: "pre-wrap", wordBreak: "break-word", maxWidth: "80%", background: v ? "linear-gradient(135deg,#061528,#081e38)" : "linear-gradient(135deg,rgba(123,47,255,0.09),rgba(123,47,255,0.03))", border: v ? "1px solid #0d3050" : "1px solid rgba(123,47,255,0.16)", borderLeft: v ? "2px solid #60efff" : undefined, borderRight: v ? undefined : "2px solid #7b2fff" }),
    mts: { fontFamily: "'Share Tech Mono', monospace", fontSize: "8px", color: "#2a5070", padding: "0 2px" },
    tbub: { padding: "10px 14px", background: "#061528", border: "1px solid #0d3050", borderLeft: "2px solid #60efff", borderRadius: "4px" },
    panel: { flex: 1, overflowY: "auto", padding: "14px", position: "relative", zIndex: 5 },
    inn: { maxWidth: "820px", margin: "0 auto" },
    stitle: { fontFamily: "'Orbitron', monospace", fontSize: "10px", color: "#00b4d8", letterSpacing: "2.5px", marginBottom: "12px", textTransform: "uppercase", paddingBottom: "5px", borderBottom: "1px solid #0d3050" },
    qg: { display: "grid", gridTemplateColumns: "repeat(3,1fr)", gap: "7px", marginBottom: "18px" },
    qc: { padding: "11px 7px", border: "1px solid #0d3050", borderRadius: "4px", background: "linear-gradient(135deg,#061528,#081e38)", cursor: "pointer", textAlign: "center", transition: "all 0.2s" },
    fld: { flex: 1, background: "#061528", border: "1px solid #0d3050", borderRadius: "3px", color: "#d0eeff", fontFamily: "'Exo 2', sans-serif", fontSize: "13px", padding: "9px 12px", outline: "none" },
    btn: { padding: "9px 15px", borderRadius: "3px", cursor: "pointer", fontFamily: "'Exo 2', sans-serif", fontSize: "11px", fontWeight: 700, letterSpacing: "1px", border: "1px solid #60efff", background: "rgba(96,239,255,0.08)", color: "#60efff" },
    btnd: { padding: "9px 15px", borderRadius: "3px", cursor: "pointer", fontFamily: "'Exo 2', sans-serif", fontSize: "11px", fontWeight: 700, letterSpacing: "1px", border: "1px solid #ff4466", background: "rgba(255,68,102,0.07)", color: "#ff4466" },
    catg: { display: "grid", gridTemplateColumns: "repeat(2,1fr)", gap: "8px", marginBottom: "12px" },
    cc: (active, color) => ({ border: "1px solid " + (active ? color : "#0d3050"), borderRadius: "4px", background: "linear-gradient(135deg,#061528,#081e38)", cursor: "pointer", overflow: "hidden", transition: "all 0.2s" }),
    tgrid: { display: "grid", gridTemplateColumns: "repeat(2,1fr)", gap: "6px" },
    ibar: { padding: "8px 14px 12px", borderTop: "1px solid #0d3050", background: "rgba(2,11,24,0.98)", zIndex: 20 },
    irow: { maxWidth: "820px", margin: "0 auto", display: "flex", gap: "7px", alignItems: "flex-end" },
    ibox: { flex: 1, position: "relative", border: "1px solid #0d3050", borderRadius: "4px", background: "#061528" },
    ibsend: { width: "46px", height: "46px", borderRadius: "4px", cursor: "pointer", flexShrink: 0, display: "flex", alignItems: "center", justifyContent: "center", fontSize: "16px", border: "1px solid rgba(96,239,255,0.38)", background: "rgba(96,239,255,0.07)", color: "#60efff" },
  };

  return (
    <div style={S.app}>
      <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@400;600;700;800&family=Share+Tech+Mono&family=Orbitron:wght@600;800&display=swap" rel="stylesheet" />
      <div style={{ position: "fixed", inset: 0, backgroundImage: "linear-gradient(rgba(96,239,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(96,239,255,0.02) 1px,transparent 1px)", backgroundSize: "52px 52px", pointerEvents: "none", zIndex: 0 }} />

      <header style={S.hdr}>
        <div style={S.hl}>
          <Logo size={40} />
          <div>
            <div style={S.h1}>VANCE</div>
            <div style={S.hsub}>PERSONAL COMMAND ENGINE V4.0</div>
          </div>
        </div>
        <div style={S.hr}>
          <div style={{ ...S.chip, borderColor: "rgba(0,245,160,0.3)", background: "rgba(0,245,160,0.06)", color: "#00f5a0" }}>
            <div style={{ width: "5px", height: "5px", borderRadius: "50%", background: "#00f5a0", boxShadow: "0 0 5px #00f5a0" }} /> ONLINE
          </div>
          <div style={{ ...S.chip, borderColor: webSearch ? "rgba(96,239,255,0.35)" : "#0d3050", background: webSearch ? "rgba(96,239,255,0.07)" : "transparent", color: webSearch ? "#60efff" : "#2a5070" }} onClick={() => setWebSearch(v => !v)}>
            {webSearch ? "WEB ON" : "WEB OFF"}
          </div>
          <div style={{ ...S.chip, borderColor: voice ? "rgba(168,85,247,0.35)" : "#0d3050", color: voice ? "#a855f7" : "#2a5070" }} onClick={() => setVoice(v => !v)}>
            {voice ? "VOICE ON" : "VOICE OFF"}
          </div>
          <div>
            <div style={S.clk}>{fmtT(time)}</div>
            <div style={S.cdt}>{fmtD(time)}</div>
          </div>
        </div>
      </header>

      <div style={S.sbar}>
        {[["MEMORY", memory.length + " NODES", "#60efff"], null, ["WEB", webSearch ? "ACTIVE" : "OFF", webSearch ? "#00f5a0" : "#2a5070"], null, ["OSINT", "100+ TOOLS", "#ffb700"], null, ["MSGS", messages.length + "", "#00b4d8"], null, ["STATUS", "ALL SYSTEMS GO", "#00f5a0"]].map((s, i) =>
          s === null
            ? <div key={i} style={{ width: "1px", height: "10px", background: "#0d3050", flexShrink: 0 }} />
            : <div key={i} style={S.si}><span style={S.sl}>{s[0]}</span><span style={{ ...S.sv, color: s[2] }}>{s[1]}</span></div>
        )}
      </div>

      <div style={S.tabs}>
        {[["chat", "💬", "Command"], ["business", "⚡", "Modules"], ["osint", "🕵️", "OSINT"], ["memory", "🧠", "Memory (" + memory.length + ")"]].map(([id, icon, label]) => (
          <button key={id} style={S.tb(tab === id)} onClick={() => setTab(id)}>{icon} {label}</button>
        ))}
      </div>

      {tab === "chat" && (
        <div style={S.chat}>
          <div style={S.msgs}>
            {messages.map((m, i) => (
              <div key={i} style={S.mrow(m.role === "assistant")}>
                <div style={S.av(m.role === "assistant")}>
                  {m.role === "assistant" ? <Logo size={20} /> : <span style={{ fontFamily: "'Orbitron',monospace", fontSize: "10px", color: "#a855f7", fontWeight: 800 }}>S</span>}
                </div>
                <div style={{ display: "flex", flexDirection: "column", maxWidth: "80%", gap: "2px", alignItems: m.role === "assistant" ? "flex-start" : "flex-end" }}>
                  <div style={S.bub(m.role === "assistant")}>{m.content}</div>
                  {m.ts && <span style={S.mts}>{fmtTs(m.ts)}</span>}
                </div>
              </div>
            ))}
            {loading && (
              <div style={S.mrow(true)}>
                <div style={S.av(true)}><Logo size={20} /></div>
                <div style={S.tbub}>
                  <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
                    <span style={{ fontFamily: "'Share Tech Mono',monospace", fontSize: "10px", color: "#00b4d8", letterSpacing: "2px" }}>PROCESSING</span>
                    {[0, 1, 2].map(i => <div key={i} style={{ width: "5px", height: "5px", borderRadius: "50%", background: "#60efff", opacity: 0.6 }} />)}
                  </div>
                </div>
              </div>
            )}
            <div ref={bottomRef} />
          </div>
        </div>
      )}

      {tab === "business" && (
        <div style={S.panel}>
          <div style={S.inn}>
            <div style={S.stitle}>Quick Command Modules</div>
            <div style={S.qg}>
              {QUICK.map((c, i) => (
                <div key={i} style={S.qc} onClick={() => { setTab("chat"); setTimeout(() => send(c.prompt), 100); }}>
                  <div style={{ fontSize: "17px", marginBottom: "4px" }}>{c.icon}</div>
                  <div style={{ fontSize: "9px", fontWeight: 700, letterSpacing: "0.5px", color: "#6a9fbf", textTransform: "uppercase" }}>{c.label}</div>
                </div>
              ))}
            </div>
            <div style={S.stitle}>Direct Command</div>
            <div style={{ display: "flex", gap: "7px", marginBottom: "18px" }}>
              <input style={S.fld} placeholder="Type any command..." value={input} onChange={e => setInput(e.target.value)} onKeyDown={e => { if (e.key === "Enter") { setTab("chat"); setTimeout(() => send(), 100); } }} />
              <button style={S.btn} onClick={() => { setTab("chat"); setTimeout(() => send(), 100); }}>EXECUTE</button>
            </div>
            <div style={S.stitle}>Session</div>
            <button style={S.btnd} onClick={() => { setMessages([]); localStorage.removeItem(HIST_KEY); setTimeout(() => initVance(), 300); }}>Clear History and Reboot VANCE</button>
          </div>
        </div>
      )}

      {tab === "osint" && (
        <div style={S.panel}>
          <div style={S.inn}>
            <div style={S.stitle}>OSINT Intelligence Framework</div>
            <div style={S.catg}>
              {Object.entries(OSINT).map(([cat, data]) => (
                <div key={cat} style={S.cc(osintCat === cat, data.color)} onClick={() => setOsintCat(osintCat === cat ? null : cat)}>
                  <div style={{ height: "2px", background: "linear-gradient(90deg," + data.color + ",transparent)" }} />
                  <div style={{ padding: "10px" }}>
                    <div style={{ fontSize: "10px", fontWeight: 700, color: "#d0eeff", textTransform: "uppercase", letterSpacing: "0.5px" }}>{cat}</div>
                    <div style={{ fontSize: "9px", color: "#2a5070", marginTop: "3px" }}>{data.tools.length} tools</div>
                  </div>
                </div>
              ))}
            </div>
            {osintCat && OSINT[osintCat] && (
              <div style={{ marginBottom: "18px", padding: "12px", border: "1px solid #1a4a70", borderRadius: "4px", background: "#061528" }}>
                <div style={{ fontFamily: "'Orbitron',monospace", fontSize: "9px", color: "#00b4d8", letterSpacing: "2px", marginBottom: "10px" }}>{osintCat.toUpperCase()}</div>
                <div style={S.tgrid}>
                  {OSINT[osintCat].tools.map((t, i) => (
                    <a key={i} href={t.url} target="_blank" rel="noreferrer" style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "8px 10px", border: "1px solid #0d3050", borderRadius: "3px", background: "#081e38", textDecoration: "none", color: "#d0eeff", fontSize: "11px", fontWeight: 600 }}>
                      {t.name} <span style={{ color: "#2a5070", fontSize: "10px" }}>&#8599;</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            <div style={S.stitle}>AI Investigation</div>
            <div style={{ display: "flex", gap: "7px", marginBottom: "12px" }}>
              <input style={S.fld} placeholder="Describe your investigation target..." value={osintQ} onChange={e => setOsintQ(e.target.value)} onKeyDown={e => { if (e.key === "Enter") askOsint(); }} />
              <button style={S.btn} onClick={askOsint} disabled={osintLoading || !osintQ.trim()}>{osintLoading ? "..." : "INVESTIGATE"}</button>
            </div>
            {osintResult && <div style={{ padding: "14px", border: "1px solid #0d3050", borderLeft: "2px solid #60efff", borderRadius: "4px", background: "#081e38", fontSize: "13px", lineHeight: 1.75, color: "#d0eeff", whiteSpace: "pre-wrap" }}>{osintResult}</div>}
          </div>
        </div>
      )}

      {tab === "memory" && (
        <div style={S.panel}>
          <div style={S.inn}>
            <div style={S.stitle}>VANCE Memory Bank</div>
            <p style={{ fontFamily: "'Share Tech Mono',monospace", fontSize: "9px", color: "#2a5070", letterSpacing: "1px", marginBottom: "14px" }}>Say "remember that..." in chat to auto-save</p>
            <div style={{ display: "flex", gap: "7px", marginBottom: "16px" }}>
              <input style={S.fld} placeholder="Add a fact VANCE should always know..." value={newMem} onChange={e => setNewMem(e.target.value)} onKeyDown={e => { if (e.key === "Enter") { if (!newMem.trim()) return; const u = [...memory, newMem.trim()]; setMemory(u); saveMem(u); setNewMem(""); } }} />
              <button style={S.btn} onClick={() => { if (!newMem.trim()) return; const u = [...memory, newMem.trim()]; setMemory(u); saveMem(u); setNewMem(""); }}>SAVE</button>
            </div>
            <div style={{ display: "flex", flexDirection: "column", gap: "7px", marginBottom: "16px" }}>
              {memory.length === 0
                ? <p style={{ fontFamily: "'Share Tech Mono',monospace", fontSize: "10px", color: "#2a5070", textAlign: "center", padding: "20px 0" }}>NO MEMORIES SAVED YET</p>
                : memory.map((m, i) => (
                  <div key={i} style={{ display: "flex", alignItems: "flex-start", gap: "8px", padding: "10px 12px", border: "1px solid #0d3050", borderLeft: "2px solid #00b4d8", borderRadius: "3px", background: "#061528" }}>
                    <span style={{ fontFamily: "'Share Tech Mono',monospace", fontSize: "9px", color: "#00b4d8", minWidth: "20px" }}>#{i + 1}</span>
                    <span style={{ flex: 1, fontSize: "12px", color: "#6a9fbf" }}>{m}</span>
                    <button onClick={() => { const u = memory.filter((_, x) => x !== i); setMemory(u); saveMem(u); }} style={{ background: "none", border: "none", color: "#2a5070", cursor: "pointer", fontSize: "12px" }}>x</button>
                  </div>
                ))
              }
            </div>
            {memory.length > 0 && <button style={S.btnd} onClick={() => { setMemory([]); saveMem([]); }}>Clear All Memories</button>}
          </div>
        </div>
      )}

      <div style={S.ibar}>
        <div style={S.irow}>
          <div style={S.ibox}>
            <span style={{ position: "absolute", left: "10px", top: "50%", transform: "translateY(-50%)", fontFamily: "'Share Tech Mono',monospace", color: "#60efff", fontSize: "11px", opacity: 0.6, pointerEvents: "none" }}>_</span>
            <textarea
              ref={inputRef}
              value={input}
              onChange={e => setInput(e.target.value)}
              onKeyDown={e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); } }}
              placeholder="Issue your command, Senator..."
              rows={1}
              disabled={loading}
              style={{ width: "100%", background: "transparent", border: "none", outline: "none", color: "#d0eeff", fontFamily: "'Exo 2',sans-serif", fontSize: "14px", padding: "12px 10px 12px 26px", resize: "none", minHeight: "46px", maxHeight: "130px", lineHeight: 1.5 }}
            />
          </div>
          <button style={{ ...S.ibsend, opacity: loading || !input.trim() ? 0.2 : 1, cursor: loading || !input.trim() ? "not-allowed" : "pointer" }} onClick={send} disabled={loading || !input.trim()}>
            {loading ? "..." : "►"}
          </button>
        </div>
        <p style={{ textAlign: "center", marginTop: "4px", fontFamily: "'Share Tech Mono',monospace", fontSize: "8px", color: "#2a5070", letterSpacing: "1px" }}>ENTER TO SEND · SHIFT+ENTER NEW LINE · MEMORY TAB · OSINT TAB</p>
      </div>
    </div>
  );
}
